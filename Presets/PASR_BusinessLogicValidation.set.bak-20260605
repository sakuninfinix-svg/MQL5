; PASR_MODULAR - Business Logic Validation Preset
; Matches current Experts/PASR_MODULAR.mq5 inputs.

InpDebugMode=true
InpEnableProfiling=true
InpTimerSeconds=1

InpMagicNumber=123456
InpEAName=PASR_MODULAR_VALIDATION

InpLotSize=0.01
InpRiskPercent=0.5
InpSLMultiplier=1.5
InpTPMultiplier=2.5
InpMaxDailyLossPct=3.0
InpMaxDrawdownPct=10.0
InpMaxOpenPositions=1
InpMaxConsecLoss=5
InpUseBreakEven=true
InpBreakEvenATRMult=1.0
InpUseTrailingStop=false
InpTrailATRMult=1.0
InpRecoveryEnabled=true
InpMaxRecoveryAttempts=2
InpRecoveryCooldownBars=5
InpPartialClosePct=0.5
InpMaxTradeDurationDays=0

InpATRPeriod=14
InpADXPeriod=14
InpADXTrendThreshold=25.0
InpSpreadFilterPips=3.0
InpSessionStartHour=0
InpSessionEndHour=23
InpFilterNewsTime=false
InpNewsBufferMinutes=30

InpEnableAI=false
InpAIMinConfidence=0.60
InpAILearningRate=0.001
InpAITrainIntervalBars=5
InpAIReplayBufferSize=512
InpAIMinibatchSize=32
InpAIPersistWeights=false
InpAIModelFileName=PASR_weights.bin

InpEnablePatterns=true
InpMinPatternScore=45.0
InpPatternLookbackBars=50
InpPinBarRatio=2.0
InpEngulfMultiplier=1.1
InpRequireConfirmation=false

InpShowDashboard=false
InpShowSignalArrows=false
InpEnableAlerts=false
InpEnablePushNotify=false
InpFontSize=9
