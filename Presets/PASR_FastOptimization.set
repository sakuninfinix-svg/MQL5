; PASR_MODULAR v1.30 - Fast Optimization Preset
; Tujuan: Mencari kombinasi parameter terbaik dalam waktu singkat
; Timeframe Recommended: M15, H1
; Cara Penggunaan: Load file ini di Strategy Tester MT5, lalu jalankan Optimization

[Input]
// --- General Settings
InpMagicNumber=889900
InpCommentTrade="PASR_Opt"
InpLogLevel=1
InpUseTimeFilter=false
InpStartHour=0
InpEndHour=23

// --- Risk Management
InpRiskPercent=1.0
InpMaxDailyLossPercent=5.0
InpMaxDailyLossAmount=0.0
InpMaxOpenOrders=3
InpMinOrderDistancePoints=0

// --- Strategy: Support & Resistance
InpSR_Sensitivity=15
InpSR_LookbackBars=50
InpSR_MinTouchCount=2
InpSR_DistancePoints=300
InpSR_ZoneWidthPoints=50
InpSR_IgnoreMinor=true

// --- Entry Filters
InpUseTrendFilter=true
InpTrendPeriod=20
InpTrendMethod=1
InpUseSpreadFilter=true
InpMaxSpreadPoints=20
InpUseVolatilityFilter=false
InpMinVolatilityPoints=0
InpMaxVolatilityPoints=0

// --- Exit Strategy
InpUseDynamicTPSL=true
InpATR_Period=14
InpTP_Multiplier=2.0
InpSL_Multiplier=1.0
InpTrailingStopEnable=false
InpTrailingStartPoints=0
InpTrailingStepPoints=0
InpBreakEvenEnable=true
InpBreakEvenPoints=200
InpBreakEvenMinimalProfit=0

// --- Execution
InpSlippagePoints=10
InpOrderExpiration=0
InpDeviationPoints=10
InpUseMarketExecution=true
