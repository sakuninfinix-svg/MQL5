; ============================================================================
; PASR_MODULAR v3.00 - THE EPIC MASTER PRESET
; ============================================================================
; Deskripsi: Single Preset untuk Semua Kebutuhan Trading & Optimization
; Fitur: Auto-Detect Mode, Smart Parameter Switching, Production-Ready
; Cara Pakai: Load file ini di MT5 Strategy Tester atau Live Trading
;             Sistem otomatis menyesuaikan parameter berdasarkan mode
; ============================================================================

[GLOBAL]
; --- Core Identity ---
InpMagicNumber=889900
InpEAName="PASR_EPIC_MASTER"
InpCommentTrade="PASR_v3_EPIC"

; --- Auto-Mode Detection (Internal Logic) ---
; Sistem akan otomatis detect:
; - MQL_OPTIMIZATION = true  → Mode Optimization (Fast, Minimal Logging)
; - MQL_OPTIMIZATION = false → Mode Normal (Full Feature, Detailed Logging)

[RISK_MANAGEMENT]
; Dynamic Risk: Conservative for validation, Aggressive for optimization
InpRiskPercent=1.0                  ; OptRange: 0.5,1.0,1.5,2.0,2.5,3.0
InpLotSize=0.01                     ; Fixed base lot
InpMaxDailyLossPct=3.0              ; OptRange: 2.0,3.0,5.0,7.0,10.0
InpMaxDrawdownPct=10.0              ; OptRange: 5.0,7.5,10.0,15.0,20.0
InpMaxOpenPositions=3               ; OptRange: 1,2,3,4,5
InpMaxConsecLoss=5                  ; Fixed safety limit
InpPartialClosePct=0.5              ; Partial close at BE

[EXIT_STRATEGY]
; Dynamic Exit: Adaptive TP/SL based on market conditions
InpSLMultiplier=1.5                 ; OptRange: 1.0,1.5,2.0,2.5,3.0
InpTPMultiplier=2.5                 ; OptRange: 1.5,2.0,2.5,3.0,3.5,4.0
InpUseBreakEven=true                ; OptRange: true,false
InpBreakEvenATRMult=1.0             ; OptRange: 0.5,1.0,1.5,2.0
InpUseTrailingStop=false            ; OptRange: true,false (enable for live)
InpTrailATRMult=1.0                 ; OptRange: 0.5,1.0,1.5,2.0
InpRecoveryEnabled=true             ; Smart recovery system
InpMaxRecoveryAttempts=3            ; Max recovery tries
InpRecoveryCooldownBars=5           ; Cooldown between recovery
InpMaxTradeDurationDays=0           ; 0 = unlimited

[MARKET_FILTERS]
; Adaptive Filters: Tighten for live, loosen for optimization
InpATRPeriod=14                     ; OptRange: 7,14,21,28,35
InpADXPeriod=14                     ; OptRange: 7,14,21,28,35
InpADXTrendThreshold=25.0           ; OptRange: 20.0,25.0,30.0,35.0,40.0
InpSpreadFilterPips=3.0             ; OptRange: 2.0,3.0,5.0,8.0,10.0
InpSessionStartHour=0               ; OptRange: 0,2,4,6,8
InpSessionEndHour=23                ; OptRange: 16,18,20,22,23
InpFilterNewsTime=false             ; OptRange: true,false
InpNewsBufferMinutes=30             ; OptRange: 15,30,45,60

[PATTERN_RECOGNITION]
; Smart Patterns: Auto-adjust sensitivity
InpEnablePatterns=true              ; OptRange: true,false
InpMinPatternScore=45.0             ; OptRange: 35.0,40.0,45.0,50.0,55.0,60.0
InpPatternLookbackBars=50           ; OptRange: 30,40,50,60,70,80
InpPinBarRatio=2.0                  ; OptRange: 1.5,2.0,2.5,3.0
InpEngulfMultiplier=1.1             ; OptRange: 1.0,1.1,1.2,1.3,1.5
InpRequireConfirmation=false        ; OptRange: true,false

[AI_ENGINE]
; AI Module: Disabled by default for speed, enable for advanced testing
InpEnableAI=false                   ; Set true for AI-assisted trading
InpAIMinConfidence=0.60             ; Minimum confidence threshold
InpAILearningRate=0.001             ; Learning rate for online training
InpAITrainIntervalBars=5            ; Training frequency
InpAIReplayBufferSize=512           ; Experience replay buffer
InpAIMinibatchSize=32               ; Mini-batch size for training
InpAIPersistWeights=true            ; Save weights between sessions
InpAIModelFileName="PASR_weights.bin"
InpAIEnableOnnx=false               ; Enable ONNX runtime
InpAIModelOnnxFileName="PASR_transformer.onnx"

[DEBUG_PROFILING]
; Auto-Switch: Enabled in normal mode, disabled in optimization
InpDebugMode=false                  ; true=verbose, false=silent
InpEnableProfiling=false            ; true=profile performance, false=off
InpTimerSeconds=1                   ; Dashboard update interval
InpLogLevel=1                       ; 0=none, 1=errors, 2=info, 3=debug

[VISUAL_ALERTS]
; Auto-Switch: Disabled in optimization for speed
InpShowDashboard=false              ; true=show dashboard, false=hide
InpShowSignalArrows=false           ; true=show arrows on chart
InpEnableAlerts=false               ; true=enable sound alerts
InpEnablePushNotify=false           ; true=send push notifications
InpFontSize=9                       ; Dashboard font size

[EXECUTION]
; Execution settings for realistic testing
InpSlippagePoints=3                 ; Realistic slippage (3 points)
InpOrderExpiration=0                ; 0=GTC (Good Till Cancelled)
InpDeviationPoints=5                ; Max price deviation
InpUseMarketExecution=true          ; Use market execution
InpMinOrderDistancePoints=0         ; Minimum distance from current price

; ============================================================================
; OPTIMIZATION WORKFLOW GUIDE
; ============================================================================
; Step 1: FAST SCREENING
;   - Load this preset
;   - Strategy Tester → Optimization → Genetic Algorithm
;   - Timeframe: M15 or H1
;   - Run quick optimization to find promising regions
;
; Step 2: DEEP OPTIMIZATION
;   - Use parameters from Step 1 as starting point
;   - Enable "Every tick based on real ticks"
;   - Run full optimization (may take hours)
;
; Step 3: VALIDATION
;   - Take top 3 parameter sets from Step 2
;   - Run forward test on out-of-sample data
;   - Verify consistency across different market conditions
;
; Step 4: LIVE DEPLOYMENT
;   - Select best performing parameter set
;   - Set InpDebugMode=false, InpShowDashboard=true
;   - Enable InpUseTrailingStop=true for live protection
;   - Deploy on VPS for 24/7 operation
;
; ============================================================================
; PERFORMANCE TIPS
; ============================================================================
; - For Optimization: Keep InpEnableAI=false, InpShowDashboard=false
; - For Live Trading: Enable trailing stops and reduce risk percent
; - For Scalping: Reduce ATRPeriod to 7-10, tighten spreads
; - For Swing Trading: Increase ATRPeriod to 21-28, widen TP/SL
; - Always test with "Every tick based on real ticks" for accuracy
; ============================================================================
